# ═════════════════════════════════════════════════════════
#  PAT-LI Textiles — Plantilla de variables de entorno
#  Copia este archivo según el subproyecto que vayas a correr:
#    · Frontend → FrontendNext/my-app/.env.local
#    · Backend  → backend/.env
#  NUNCA subas los archivos .env reales al repositorio.
# ═════════════════════════════════════════════════════════

# ── FRONTEND (Next.js) → FrontendNext/my-app/.env.local ──
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Google Gemini AI (Genkit) — obtener en https://aistudio.google.com
GOOGLE_GENAI_API_KEY=AIzaSy...
# Clave secundaria: se usa automáticamente si la primera agota su cuota
GOOGLE_GENAI_API_KEY_2=AIzaSy...


# ── BACKEND (Node.js / Express) → backend/.env ───────────
PORT=3000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_chatbot_ventas
DB_USER=root
DB_PASSWORD=

# Autenticación
JWT_SECRET=reemplazar_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# OpenAI (opcional, si el backend lo utiliza)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
