PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_chatbot_ventas
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=tu_clave_secreta_muy_larga_aqui_reemplazar
JWT_EXPIRES_IN=8h

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# System Prompt
SYSTEM_PROMPT=Eres un asistente de ventas de la empresa PAT-LI, especializada en productos textiles en Ica, Perú. Ayudas a los clientes con información de productos, precios, disponibilidad y proceso de compra. Sé amable, conciso y útil. Si el cliente quiere comprar, solicita sus datos de contacto.
